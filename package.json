{
  "name": "repodesk-landing",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "bun test tests/unit",
    "test:browser": "playwright test",
    "verify": "bun run check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "isbot": "5.1.35"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
